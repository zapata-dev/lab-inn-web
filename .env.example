# ── App ──────────────────────────────────────────────────────────────────────
VITE_BRAND_NAME=LAB
VITE_VERSION=1.0.0

# ── Auth mode ─────────────────────────────────────────────────────────────────
# firebase = Auth Google real + Firestore
# demo     = modo sin Firebase (solo para desarrollo local sin credenciales)
VITE_AUTH_MODE=firebase

# ── Firebase ──────────────────────────────────────────────────────────────────
# Copiar desde Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Solo correos @zapata.com.mx pueden iniciar sesion
VITE_FIREBASE_ALLOWED_DOMAIN=zapata.com.mx

# ── Inventario ────────────────────────────────────────────────────────────────
# firestore = inventario desde Firestore (production)
# demo      = inventario estatico de ejemplo
VITE_INVENTORY_SOURCE_MODE=firestore

# Horas antes de mostrar aviso de inventario desactualizado
VITE_INVENTORY_STALE_HOURS=24
